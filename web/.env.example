# Where the api lives: local dev server (npm run api) or the deployed function
VITE_API_BASE=http://localhost:8787
# Optional: ElevenLabs agent ids (without them the browser voice fallback is used)
VITE_ELEVENLABS_INTERVIEWER_AGENT_ID=
VITE_ELEVENLABS_TUTOR_AGENT_ID=

# Firebase web config: never commit values. `npm run setup -w tools` writes them into web/.env.local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
